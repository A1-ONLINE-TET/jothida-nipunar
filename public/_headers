# Cloudflare Pages security headers for ஜோதிட நிபுணர்.
# These are safe defaults that do not break Firebase Auth / reCAPTCHA.
# A Content-Security-Policy is intentionally left out here because it must
# be tuned to your exact Firebase project + Worker domain and TESTED with
# phone-auth/reCAPTCHA before enabling — see docs/SECURITY-DEPLOY.md.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Files with a content hash in their name never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be re-checked so app updates reach users.
/sw.js
  Cache-Control: no-cache

# Android app ↔ website verification (Trusted Web Activity).
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
